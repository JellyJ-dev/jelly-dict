}
QFrame#entryEditPanel {
    background: #20201f;
    border: 1px solid #3f3f3c;
    border-radius: 14px;
}
QLabel#entryEditFormLabel {
    color: #aaa59c;
    font-size: 12px;
    font-weight: 700;
