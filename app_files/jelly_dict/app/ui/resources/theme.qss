}
QListWidget#settingsVoiceList::item {
    border-radius: 10px;
    padding: 7px 9px;
    margin: 2px;
}
QListWidget#settingsVoiceList::item:hover {
    background: #2a2a28;
}
QListWidget#settingsVoiceList::item:selected {
    background: #3a322d;
    color: #f1ece2;
}
QDialog#entryDetailDialog {
    background: #2a2a28;
