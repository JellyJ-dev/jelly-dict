}
QPushButton#undoToastButton {
    background: transparent;
    color: rgba(255, 128, 84, 235);
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 0 10px;
    min-height: 28px;
    max-height: 28px;
    font-size: 13px;
    font-weight: 750;
